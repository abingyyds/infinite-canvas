# 管理员账号。配置后首次启动会自动创建；生产环境请使用强密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 默认不允许在后台新增、提权、降级、禁用或删除管理员账号。
ADMIN_ALLOW_ROLE_MANAGEMENT=false

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_DOC_URL=https://docs.canvas.best

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# 白标账号网关登录。配置后，用户可用同一套账号密码登录，并由后端自动创建/复用用户自己的访问密钥。
# 可同时配置多个来源，main/site 分别对应不同网关登录接口；普通登录失败后会按顺序尝试。
# SubRouter 用户直接登录通常只需要 main；分站用户会在登录后识别归属并使用自己的分站密钥和余额。
# GATEWAY_LOGIN_SOURCES=main=https://gateway.example.com;site@site.example.com=https://gateway.example.com
# 只有一个网关地址时可用该简写，后端只尝试 main 登录接口。
# GATEWAY_BASE_URL=https://gateway.example.com
# 分站账号自动识别后，新版网关会按当前用户归属创建密钥；旧版分站密钥接口需要可识别站点 Host。
# 单分站可直接填完整域名；多分站可填后缀或模板。
# GATEWAY_SITE_HOST=site.example.com
# GATEWAY_SITE_HOST_SUFFIX=example.com
# GATEWAY_SITE_HOST_TEMPLATE={slug}.example.com
# AI 请求运行时使用的 OpenAI 兼容接口地址，未配置时会基于登录网关地址自动补 /v1。
# GATEWAY_PUBLIC_BASE_URL=https://gateway.example.com
# GATEWAY_FALLBACK_BASE_URL=https://gateway-backup.example.com
# GATEWAY_BASE_URL_CANDIDATES=https://gateway.example.com,https://gateway-backup.example.com
# 订阅模型接口路径可按网关实际部署覆盖；不配置则使用内置兼容路径。
# GATEWAY_SUBSCRIBED_MODELS_PATH=/api/user/self/{routing}/models
# GATEWAY_KEY_PREFIX=canvas-auto
# GATEWAY_KEY_GROUP=default
# GATEWAY_KEY_GROUP_ID=1
# GATEWAY_ALLOW_LOGIN_FALLBACK=true
